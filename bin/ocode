#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$SCRIPT_DIR/../share/ocode-harness/harness-runtime/bin/ocode.mjs" ]; then
  OCODE_RUNTIME="$SCRIPT_DIR/../share/ocode-harness/harness-runtime/bin/ocode.mjs"
  HARNESS_RUNTIME="$SCRIPT_DIR/../share/ocode-harness/harness-runtime/bin/harness.mjs"
elif [ -f "$SCRIPT_DIR/../packages/harness-runtime/bin/ocode.mjs" ]; then
  OCODE_RUNTIME="$SCRIPT_DIR/../packages/harness-runtime/bin/ocode.mjs"
  HARNESS_RUNTIME="$SCRIPT_DIR/../packages/harness-runtime/bin/harness.mjs"
else
  echo "ERROR: Ocode runtime wrapper not found; refusing raw OpenCode fallback." >&2
  exit 1
fi

case "${1:-}" in
  version)
    exec node "$HARNESS_RUNTIME" "$@"
    ;;
  --version|-V)
    exec node "$HARNESS_RUNTIME" version
    ;;
  *)
    exec node "$OCODE_RUNTIME" "$@"
    ;;
esac
