{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocode.local/schemas/release-manifest.schema.json",
  "title": "Ocode Immutable Release Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "version",
    "roadmap_milestone",
    "source_commit",
    "artifact_digest",
    "materialization",
    "qualification_evidence",
    "runtime_dependencies",
    "compatibility_constraints",
    "known_limitations",
    "release_state",
    "promotion_authority",
    "promotion_evidence",
    "prior_stable",
    "rollback"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "roadmap_milestone": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact_digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"enum": ["sha256"]},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "materialization": {
      "type": "object",
      "required": ["method", "inputs"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "tool_version": {"type": ["string", "null"]},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "qualification_evidence": {"type": "array", "items": {"type": "string"}},
    "runtime_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "constraint"],
        "properties": {
          "name": {"type": "string"},
          "constraint": {"type": "string"},
          "qualification_ref": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "compatibility_constraints": {"type": "array", "items": {"type": "string"}},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "release_state": {"enum": ["dev", "candidate", "stable"]},
    "promotion_authority": {"type": "string", "minLength": 1},
    "promotion_evidence": {"type": "array", "items": {"type": "string"}},
    "prior_stable": {"type": ["string", "null"]},
    "rollback": {
      "type": "object",
      "required": ["eligible", "prior_release_id", "selector", "evidence_retention"],
      "properties": {
        "eligible": {"type": "boolean"},
        "prior_release_id": {"type": ["string", "null"]},
        "selector": {"type": ["string", "null"]},
        "evidence_retention": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
