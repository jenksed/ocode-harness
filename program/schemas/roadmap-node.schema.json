{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocode.local/schemas/roadmap-node.schema.json",
  "title": "Ocode Roadmap Node",
  "type": "object",
  "required": ["identity", "purpose", "authority", "dependencies", "evidence", "planning", "release", "execution"],
  "properties": {
    "identity": {
      "type": "object",
      "required": ["id", "title", "type", "horizon", "lifecycle_state", "capability_era", "release_train"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9.-]+$"},
        "title": {"type": "string", "minLength": 1},
        "type": {"enum": ["major_milestone", "work_package"]},
        "horizon": {"enum": ["ACTIVE", "NEXT", "LATER", "STRATEGIC"]},
        "lifecycle_state": {"enum": ["future", "decomposition_ready", "authorized", "executing", "evidence_pending", "accepted", "superseded"]},
        "capability_era": {"type": "string"},
        "release_train": {"type": "string"}
      },
      "additionalProperties": false
    },
    "purpose": {
      "type": "object",
      "required": ["intent", "required_properties", "non_goals"],
      "properties": {
        "intent": {"type": "string", "minLength": 1},
        "required_properties": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "non_goals": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["planning_authority", "decomposition_authority", "implementation_authority", "acceptance_authority", "release_authority", "forbidden_authority"],
      "properties": {
        "planning_authority": {"type": "string", "minLength": 1},
        "decomposition_authority": {"type": "string", "minLength": 1},
        "implementation_authority": {"type": "string", "minLength": 1},
        "acceptance_authority": {"type": "string", "minLength": 1},
        "release_authority": {"type": "string", "minLength": 1},
        "forbidden_authority": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "required": ["hard_prerequisites", "soft_dependencies", "consumed_contracts", "unresolved_shared_decisions", "integration_dependencies"],
      "properties": {
        "hard_prerequisites": {"type": "array", "items": {"type": "string"}},
        "soft_dependencies": {"type": "array", "items": {"type": "string"}},
        "consumed_contracts": {"type": "array", "items": {"type": "string"}},
        "unresolved_shared_decisions": {"type": "array", "items": {"type": "string"}},
        "integration_dependencies": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["known_evidence", "evidence_references", "unproven_properties", "required_acceptance_evidence"],
      "properties": {
        "known_evidence": {"type": "array", "items": {"type": "string"}},
        "evidence_references": {"type": "array", "items": {"type": "string"}},
        "unproven_properties": {"type": "array", "items": {"type": "string"}},
        "required_acceptance_evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "planning": {
      "type": "object",
      "required": ["decomposition_trigger", "research_refresh_trigger", "replanning_trigger", "supersession_conditions", "stop_conditions"],
      "properties": {
        "decomposition_trigger": {"type": "string"},
        "research_refresh_trigger": {"type": "string"},
        "replanning_trigger": {"type": "string"},
        "supersession_conditions": {"type": "array", "items": {"type": "string"}},
        "stop_conditions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["release_checkpoint", "usable_capability_created", "candidate_requirements", "promotion_requirements", "compatibility_implications", "rollback_implications"],
      "properties": {
        "release_checkpoint": {"type": "boolean"},
        "usable_capability_created": {"type": "string"},
        "candidate_requirements": {"type": "array", "items": {"type": "string"}},
        "promotion_requirements": {"type": "array", "items": {"type": "string"}},
        "compatibility_implications": {"type": "array", "items": {"type": "string"}},
        "rollback_implications": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["parallelism_classification", "work_packages", "validation_commands", "completion_output_contract"],
      "properties": {
        "parallelism_classification": {"enum": ["parallel-safe", "parallel-safe-after-contract-freeze", "integration-gated", "serialized", "owner-decision-blocked"]},
        "work_packages": {"type": "array", "items": {"type": "string"}},
        "validation_commands": {"type": "array", "items": {"type": "string"}},
        "completion_output_contract": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
