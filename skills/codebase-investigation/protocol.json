{"schema_version":1,"skill_id":"codebase-investigation","skill_version":"1.0.0","purpose":"Resolve a bounded repository question with evidenced facts, explicit inference, and explicit gaps without mutation.","applicability":[{"id":"bounded-question","when":"A bounded repository question and initial inspection surface exist."},{"id":"repository-evidence","when":"The answer can be grounded in admitted repository evidence."}],"non_applicability":[{"id":"implementation","when":"The task requires implementation."},{"id":"repair","when":"The task requires repair."},{"id":"external-research","when":"Required evidence is external."},{"id":"unbounded","when":"The objective cannot be bounded."},{"id":"outside-capability","when":"Required evidence is outside admitted context or capability."},{"id":"already-determined","when":"A deterministic answer is already available without reasoning."}],"requirements":{"capabilities":["repository.read"],"requested_authority":{"edit":false,"stage":false,"commit":false,"push":false}},"method":{"stages":[{"id":"bound-question","objective":"Bound the question and supplied seams.","required_inputs":["objective","context"],"required_outputs":["inspection-plan"]},{"id":"inspect","objective":"Trace only justified dependencies.","required_inputs":["inspection-plan"],"required_outputs":["repository-facts"]},{"id":"report","objective":"Separate facts, inference, and gaps; answer then stop.","required_inputs":["repository-facts"],"required_outputs":["skill-result"]}],"max_structured_repairs":1},"outputs":[{"id":"skill-result","kind":"EvidenceCapsule","required":true}],"evidence_requirements":[{"id":"repository-facts","kind":"repository","required":true}],"acceptance":[{"id":"question-bounded","condition":"Repository question is bounded."},{"id":"surface-bounded","condition":"Initial inspection surface is bounded."},{"id":"expansion-justified","condition":"Dependency expansion is justified."},{"id":"facts-grounded","condition":"Facts are grounded in repository evidence."},{"id":"facts-separated","condition":"Facts and inference are separated."},{"id":"gaps-explicit","condition":"Unknowns and evidence gaps are explicit."},{"id":"no-mutation","condition":"No source mutation occurs."},{"id":"answer-sufficient","condition":"Answer resolves the bounded question."},{"id":"stop-when-answered","condition":"Inspection stops when sufficient."}],"failure_conditions":[{"id":"outside-context","condition":"Required evidence is outside admitted context."},{"id":"unbounded-question","condition":"Question cannot be bounded."}],"stop_conditions":[{"id":"answer-complete","condition":"Bounded answer and gaps are reported."}],"qualification_requirements":{"positive_fixture":true,"method_violation_fixture":true,"authority_capability_negative_fixture":true,"evidence_integrity_negative_fixture":true,"context_economy_observation":true,"live_qualification":"REQUIRED"}}
