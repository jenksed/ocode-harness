{
  "description": "Default profile for ocode-harness v0.1",
  "provider": {
    "freellmapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeLLMAPI",
      "options": {
        "baseURL": "http://127.0.0.1:3001/v1"
      },
      "models": {
        "auto:smart": {
          "name": "FreeLLMAPI Smart Router",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },
  "default_agent": "orchestrator",
  "subagent_depth": 1,
  "task_allowlist": [
    "planner",
    "coder",
    "researcher",
    "verifier",
    "reviewer",
    "judge",
    "committer"
  ]
}
