{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocode.local/schemas/binding-profile-v1.json",
  "title": "Ocode OpenCode binding profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "policy_version",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[^/\\s]+/[^\\s]+$"
      }
    }
  }
}
